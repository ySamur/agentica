{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:security)",
      "Bash(npx playwright test *)",
      "Bash(npx oxlint *)",
      "PowerShell(npm.cmd run typecheck)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(npm.cmd run lint)",
      "PowerShell(npm.cmd test *)",
      "PowerShell(npm.cmd run test:security)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.mjs\"",
            "timeout": 120,
            "statusMessage": "Проверка типов…"
          }
        ]
      }
    ]
  }
}
